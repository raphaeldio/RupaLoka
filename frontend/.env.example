# Variabel frontend (Vite). Bukan rahasia: nilainya ikut terkirim ke peramban.
# Salin ke frontend/.env.local untuk pengembangan; di Vercel isi di Project Settings → Environment Variables.

# Basis URL API (kosong = asal yang sama; /api diteruskan ke Render oleh vercel.json).
VITE_API_BASE=

# Tombol "Beri masukan" di kartu budaya dan materi (masukan juri, 25 Nov 2026).
# TODO tim: URL Google Form (https://docs.google.com/forms/d/e/.../viewform). Kosong = tombol disembunyikan.
VITE_FEEDBACK_FORM_URL=
# Opsional: id isian otomatis (mis. entry.123456789) untuk "<kota> / <judul> (<id>)".
VITE_FEEDBACK_FORM_ENTRY=
