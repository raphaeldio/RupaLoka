{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "backend/.venv/Scripts/uvicorn.exe",
      "runtimeArgs": [
        "app.main:app",
        "--app-dir",
        "backend",
        "--port",
        "8000"
      ],
      "port": 8000
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "dev",
        "--",
        "--port",
        "5173"
      ],
      "port": 5173
    },
    {
      "name": "galeri-mock",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "mocks/galeri-kamera",
        "run",
        "dev",
        "--",
        "--port",
        "5180"
      ],
      "port": 5180
    }
  ]
}
