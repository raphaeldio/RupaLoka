# Salin ke .env (jangan di-commit). Semua kunci hanya untuk server (Render), bukan frontend.

# --- Konten ---
# CONTENT_DIR=../content          # default: <repo>/content
CONTENT_STRICT=false              # true = data belum diisi/diverifikasi menggagalkan startup
ALLOWED_ORIGINS=http://localhost:5173

# --- Agen AI (T-013, Gemini) ---
GEMINI_API_KEY=                   # dari Google AI Studio; rahasia
GEMINI_MODEL=gemini-3.5-flash-lite
LLM_TIMEOUT_S=15
MIN_SCORE=1.0                     # ambang BM25 mentah; kalibrasi di T-062
RATE_LIMIT_PER_MIN=20             # per IP, untuk /api/chat
MASCOT_NAME=Pemandu Rupaloka      # [PERLU DIISI] nama maskot final
LOG_CHAT=false                    # belum dipakai; log ke Supabase menyusul (T-062)

# --- Supabase: data runtime (log chat, analitik P1, akun P2) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=        # rahasia; hanya di backend
