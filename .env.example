# Salin ke .env (jangan di-commit). Semua kunci hanya untuk server (Render), bukan frontend.

# --- Konten ---
# CONTENT_DIR=../content          # default: <repo>/content
CONTENT_STRICT=false              # true = data belum diisi/diverifikasi menggagalkan startup
ALLOWED_ORIGINS=http://localhost:5173

# --- Agen AI (T-013, Gemini) ---
GEMINI_API_KEY=                   # dari Google AI Studio; rahasia
GEMINI_MODEL=gemini-3.5-flash-lite
LLM_TIMEOUT_S=15
MIN_SCORE=5.45                    # ambang jalur skor (gerbang dua jalur); kalibrasi: eval_rag.py --strict
RATE_LIMIT_PER_MIN=20             # per IP, untuk /api/chat
GLOBAL_RATE_LIMIT_PER_MIN=120     # total semua IP, untuk /api/chat (pengaman kuota)

# --- Keamanan (T-064) ---
TRUSTED_PROXY_HOPS=0              # 0 = abaikan X-Forwarded-For (lokal); Render lewat Vercel = 2
ENABLE_DOCS=true                  # /docs Swagger; false di produksi
MASCOT_NAME=Saloka                # nama agen (25 Nov 2026)
LOG_CHAT=false                    # belum dipakai; log ke Supabase menyusul (T-062)

# --- Supabase: data runtime (log chat, analitik P1, akun P2) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=        # rahasia; hanya di backend
LEADERBOARD_RATE_LIMIT_PER_MIN=10 # per IP, untuk POST /api/leaderboard

# --- Suara Saloka: ElevenLabs TTS (SDD ADR 42). Kosong = klien pakai suara peramban ---
ELEVENLABS_API_KEY=               # rahasia; hanya di backend
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb  # voice bawaan "George"; voice Library butuh paket berbayar
ELEVENLABS_MODEL=eleven_multilingual_v2
TTS_RATE_LIMIT_PER_MIN=30         # per IP, untuk /api/tts
TTS_GLOBAL_RATE_LIMIT_PER_MIN=120
TTS_DAILY_CHAR_LIMIT=20000        # kuota karakter per hari (semua pengguna)
